# Teacher model (local HuggingFace model)
TEACHER_MODEL=deepseek-ai/DeepSeek-R1-Distill-Qwen-7B
TEACHER_SYSTEM_PROMPT=You are a helpful assistant.
TEACHER_MAX_NEW_TOKENS=512

# Dataset source (see src/anti_distill/loaders/registry.py for available datasets)
DATASET_NAME=gsm8k
DATASET_CONFIG=main
DATASET_SPLIT=train
DATASET_PATH=data/holdout.jsonl
NUM_SAMPLES=100

# Student model (HuggingFace model ID)
STUDENT_MODEL_ID=facebook/opt-125m
OUTPUT_DIR=models/student
NUM_TRAIN_EPOCHS=3
BATCH_SIZE=4
LEARNING_RATE=2e-5
MAX_SEQ_LENGTH=512
