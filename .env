# Teacher model (HuggingFace)
TEACHER_MODEL=unsloth/gemma-3-12b-it
TEACHER_MAX_NEW_TOKENS=2048
TEACHER_BATCH_SIZE=4096
TEACHER_CAA_BATCH_SIZE=32
TEACHER_TEMPERATURE=0.7
TEACHER_HOLDOUT_TEMPERATURE=0.0
VLLM_GPU_MEMORY_UTILIZATION=0.8

# Dataset
DATASET_NAME=gsm8k
DATASET_CONFIG=all
DATASET_SPLIT=train
NUM_SAMPLES_TRAIN=
NUM_SAMPLES_TEST=
NUM_SAMPLES_TEACHER_FINETUNE=500

# Rewriter model
REWRITER_MODEL_ID=unsloth/gemma-3-12b-it
REWRITER_MAX_NEW_TOKENS=1024
REWRITER_TEMPERATURE=0.5
REWRITER_PROMPT_VARIANT=all

# Student model
STUDENT_MODEL_ID=Qwen/Qwen2.5-3B
STUDENT_MAX_NEW_TOKENS=2048
STUDENT_TEMPERATURE=0.0
STUDENT_OUTPUT_DIR=models/student
STUDENT_NUM_TRAIN_EPOCHS=2
STUDENT_PER_DEVICE_TRAIN_BATCH_SIZE=2
STUDENT_PER_DEVICE_EVAL_BATCH_SIZE=8
STUDENT_GRADIENT_ACCUMULATION_STEPS=8
STUDENT_LEARNING_RATE=1e-4
STUDENT_WEIGHT_DECAY=0.1
STUDENT_WARMUP_RATIO=0.05
STUDENT_MAX_SEQ_LENGTH=4096
STUDENT_GRADIENT_CHECKPOINTING=false
STUDENT_VAL_SPLIT_RATIO=0.0
STUDENT_LORA_R=16
STUDENT_LORA_ALPHA=32
STUDENT_LORA_DROPOUT=0.0
STUDENT_LORA_TARGET_MODULES=["q_proj","k_proj","v_proj","o_proj","gate_proj","up_proj","down_proj"]

# Teacher fine-tuning
TEACHER_NUM_TRAIN_SAMPLES=
TEACHER_NUM_EVAL_SAMPLES=
TEACHER_NUM_TRAIN_EPOCHS=3
TEACHER_PER_DEVICE_TRAIN_BATCH_SIZE=4
TEACHER_PER_DEVICE_EVAL_BATCH_SIZE=2
TEACHER_GRADIENT_ACCUMULATION_STEPS=2
TEACHER_LEARNING_RATE=5e-5
TEACHER_WEIGHT_DECAY=0.0
TEACHER_WARMUP_RATIO=0.05
TEACHER_MAX_SEQ_LENGTH=4096
TEACHER_GRADIENT_CHECKPOINTING=false
TEACHER_VAL_SPLIT_RATIO=0.0
TEACHER_LORA_R=16
TEACHER_LORA_ALPHA=32
TEACHER_LORA_DROPOUT=0.0
TEACHER_LORA_TARGET_MODULES=["q_proj","k_proj","v_proj","o_proj"]

# Style layer training
STYLE_BATCH_SIZE=1
STYLE_GRAD_ACCUM_STEPS=8
STYLE_LEARNING_RATE=1e-4
STYLE_EPOCHS=1
STYLE_MAX_SEQ_LENGTH=512
STYLE_DIM=64
STYLE_BOTTLENECK_DIM=64

# CAA vector extraction
CAA_EXTRACTION_SAMPLES=
CAA_INSERTION_LAYERS=

# CAA inference
CAA_CHECKPOINT_PATH=models/steering_vectors_caa/steering_vectors.pt
