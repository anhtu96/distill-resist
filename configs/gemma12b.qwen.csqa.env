# Teacher model (HuggingFace)
TEACHER_MODEL=unsloth/gemma-3-12b-it
TEACHER_MAX_NEW_TOKENS=2048
TEACHER_BATCH_SIZE=2048
TEACHER_CAA_BATCH_SIZE=64
TEACHER_CAA_TEST_BATCH_SIZE=32
TEACHER_TEMPERATURE=0.7
TEACHER_HOLDOUT_TEMPERATURE=0.7
TEACHER_FRESH_STYLE_TEMPERATURE=0.9
TEACHER_FRESH_STYLE_SAMPLES=100
VLLM_GPU_MEMORY_UTILIZATION=0.7

# Dataset
DATASET_NAME=csqa
DATASET_CONFIG=all
DATASET_SPLIT=100
NUM_SAMPLES_TRAIN=
NUM_SAMPLES_TEST=
NUM_SAMPLES_TEACHER_FINETUNE=500

# Rewriter model
REWRITER_MODEL_ID=unsloth/gemma-3-12b-it
REWRITER_MAX_NEW_TOKENS=1024
REWRITER_TEMPERATURE=0.8
REWRITER_PROMPT_VARIANT=all
REWRITER_SAMPLES=100

# Student model
STUDENT_MODEL_ID=Qwen/Qwen2.5-3B
STUDENT_MAX_NEW_TOKENS=2048
STUDENT_TEMPERATURE=0.0
STUDENT_NUM_TRAIN_SAMPLES=
STUDENT_NUM_EVAL_SAMPLES=100
ANSWER_FORCE_BATCH_SIZE=1024
STUDENT_OUTPUT_DIR=models/student
STUDENT_NUM_TRAIN_EPOCHS=3
STUDENT_PER_DEVICE_TRAIN_BATCH_SIZE=2
STUDENT_PER_DEVICE_EVAL_BATCH_SIZE=64
STUDENT_GRADIENT_ACCUMULATION_STEPS=8
STUDENT_LEARNING_RATE=1e-4
STUDENT_WEIGHT_DECAY=0.1
STUDENT_WARMUP_RATIO=0.05
STUDENT_MAX_SEQ_LENGTH=4096
STUDENT_GRADIENT_CHECKPOINTING=false
STUDENT_VAL_SPLIT_RATIO=0.0
STUDENT_LORA_R=16
STUDENT_LORA_ALPHA=32
STUDENT_LORA_DROPOUT=0.0
STUDENT_LORA_TARGET_MODULES=["q_proj","k_proj","v_proj","o_proj","gate_proj","up_proj","down_proj"]

# Teacher fine-tuning
TEACHER_NUM_TRAIN_SAMPLES=
TEACHER_NUM_EVAL_SAMPLES=
TEACHER_NUM_TRAIN_EPOCHS=3
TEACHER_PER_DEVICE_TRAIN_BATCH_SIZE=4
TEACHER_PER_DEVICE_EVAL_BATCH_SIZE=2
TEACHER_GRADIENT_ACCUMULATION_STEPS=2
TEACHER_LEARNING_RATE=5e-5
TEACHER_WEIGHT_DECAY=0.0
TEACHER_WARMUP_RATIO=0.05
TEACHER_MAX_SEQ_LENGTH=4096
TEACHER_GRADIENT_CHECKPOINTING=false
TEACHER_VAL_SPLIT_RATIO=0.0
TEACHER_LORA_R=16
TEACHER_LORA_ALPHA=32
TEACHER_LORA_DROPOUT=0.0
TEACHER_LORA_TARGET_MODULES=["q_proj","k_proj","v_proj","o_proj"]

# Style layer training
STYLE_BATCH_SIZE=1
STYLE_GRAD_ACCUM_STEPS=8
STYLE_LEARNING_RATE=1e-4
STYLE_EPOCHS=1
STYLE_MAX_SEQ_LENGTH=512
STYLE_DIM=64
STYLE_BOTTLENECK_DIM=64

# CAA vector extraction
CAA_EXTRACTION_SAMPLES=100

# CAA inference
CAA_INSERTION_LAYERS=[20, 25]
CAA_CHECKPOINT_PATH=models/steering_vectors_caa_vllm/steering_vectors_gemma-3-12b-it.pt
CAA_STRENGTH={"scratchpad": [0.07, 0.04], "dead_end": [0.07, 0.05], "distractor": [0.07, 0.05], "jargon": [0.07, 0.05]}
#CAA_P_ACTIVE=0.98
CAA_P_ACTIVE=1.0
CAA_USER_ID=synthetic
CAA_BATCH_SIZE=32
CAA_SAMPLES=
CAA_WEIGHT_MODE=binarize
CAA_NORMALIZE=true
CAA_RELATIVE=true
CAA_MAX_INJECTION_TOKENS={"scratchpad": 70, "dead_end": 150, "distractor": 150, "jargon": 100}
CAA_STRENGTH_BLEND_MODE=dominant
CAA_MAX_TOKENS_BLEND_MODE=dominant
CAA_INJECT_PREFILL=false
CAA_INJECT_PREFILL_LAST_N={"scratchpad": 50, "dead_end": 50, "distractor": 50, "jargon": 50}
CAA_INJECT_PREFILL_LAST_N_BLEND_MODE=dominant
CAA_DIRICHLET_ALPHAS=[0.3, 0.3, 0.3, 0.3]
CAA_STYLE_SCALES={"scratchpad": 1.0, "dead_end": 1.0, "distractor": 1.0, "jargon": 1.0}
CAA_ACTIVE_STYLES=["scratchpad", "dead_end", "distractor", "jargon"]
ANSWER_FORCING=true
ANSWER_FORCE_MAX_TOKENS=64

# Sync / logging
HF_REPO=
WANDB_PROJECT=distill-resist
